<Window x:Class="TaskHub.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskHub" Height="800" Width="600" Background="#1E1E1E" WindowStartupLocation="CenterScreen"
        x:Name="RootWindow">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Formular Task" Foreground="#BB86FC" Grid.Row="0" Margin="0,0,0,10" BorderBrush="#333333">
            <StackPanel Margin="10">
                <Label x:Name="lblTitlu" Content="Titlu (3-15 caractere):"/>
                <TextBox x:Name="txtTitlu" Height="25" Background="#2D2D2D" Foreground="White" CaretBrush="White"/>

                <Label x:Name="lblCategorie" Content="Categorie:"/>
                <ComboBox x:Name="cmbCategorie" Height="25">
                    <ComboBoxItem Content="Personal"/>
                    <ComboBoxItem Content="Work"/>
                    <ComboBoxItem Content="Scoala"/>
                </ComboBox>

                <Label x:Name="lblZile" Content="Zile până la termen:"/>
                <TextBox x:Name="txtZile" Height="25" Background="#2D2D2D" Foreground="White" CaretBrush="White"/>

                <Label Content="Urgent?" Foreground="White"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rbUrgentDa" Content="Da" Foreground="White" Margin="0,5,15,5"/>
                    <RadioButton x:Name="rbUrgentNu" Content="Nu" Foreground="White" IsChecked="True"/>
                </StackPanel>

                <UniformGrid Columns="2" Margin="0,15,0,0">
                    <Button x:Name="btnSalveaza" 
                            Content="{Binding TextButonSalvare, ElementName=RootWindow}" 
                            Click="btnAdauga_Click" Height="30" Background="#BB86FC" FontWeight="Bold"/>

                    <Button Content="Reset" Click="btnReset_Click" Height="30" Background="#333333" Foreground="White"/>
                </UniformGrid>
            </StackPanel>
        </GroupBox>

        <DockPanel Grid.Row="1" Margin="0,5,0,10">
            <Button Content="Done" Click="btnDone_Click" DockPanel.Dock="Right" Width="60" Background="Green" Foreground="White" FontWeight="Bold" Margin="5,0,0,0"
                    IsEnabled="{Binding SelectedItem, ElementName=dgTaskuri, Converter={x:Null}}"/>

            <Button Content="Edit" Click="btnEdit_Click" DockPanel.Dock="Right" Width="60" Background="Orange" FontWeight="Bold" Margin="5,0,0,0"
                    IsEnabled="{Binding SelectedItem, ElementName=dgTaskuri, Converter={x:Null}}"/>

            <Button Content="🔍" Click="btnCauta_Click" DockPanel.Dock="Right" Width="35" Margin="5,0,0,0" Background="#333333" Foreground="White"/>
            <TextBox x:Name="txtCautare" Height="25" Background="#2D2D2D" Foreground="White" VerticalContentAlignment="Center"/>
        </DockPanel>

        <DataGrid x:Name="dgTaskuri" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="#252525" RowBackground="#2D2D2D" AlternatingRowBackground="#333333" Foreground="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Titlu" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="100"/>
                <DataGridCheckBoxColumn Header="Urgent" Binding="{Binding IsUrgent}" Width="60"/>
                <DataGridTextColumn Header="Deadline" Binding="{Binding DueDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>