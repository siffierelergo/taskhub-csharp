<Window x:Class="TaskHub.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskHub" Height="780" Width="600" 
        WindowStartupLocation="CenterScreen" Background="#1E1E1E">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Adăugare Task Nou" Foreground="#BB86FC" Grid.Row="0" Margin="0,0,0,10" BorderBrush="#333333">
            <StackPanel Margin="10">
                <Label x:Name="lblTitlu" Content="_Titlu Task:"/>
                <TextBox x:Name="txtTitlu" Height="25" Background="#2D2D2D" Foreground="White" CaretBrush="White"/>
                <TextBlock x:Name="errTitlu" Text="Titlu invalid (3-15 caractere)!" Foreground="Tomato" Visibility="Collapsed"/>

                <Label Content="_Categorie:"/>
                <ComboBox x:Name="cmbCategorie" Height="30">
                    <ComboBoxItem Content="Personal"/>
                    <ComboBoxItem Content="Work"/>
                    <ComboBoxItem Content="Scoala"/>
                </ComboBox>

                <Label Content="_Termen (zile):"/>
                <TextBox x:Name="txtZile" Height="25" Background="#2D2D2D" Foreground="White" CaretBrush="White"/>

                <Label Content="Este Urgent?" Foreground="White" Margin="0,10,0,0"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="rbUrgentDa" Content="Da" Foreground="White" Margin="0,0,15,0"/>
                    <RadioButton x:Name="rbUrgentNu" Content="Nu" Foreground="White" IsChecked="True"/>
                </StackPanel>

                <UniformGrid Columns="2" Margin="0,15,0,0">
                    <Button Content="Salvează" Click="btnAdauga_Click" Height="35" Background="#BB86FC" FontWeight="Bold"/>
                    <Button Content="Reset" Click="btnReset_Click" Height="35" Background="#333333" Foreground="White"/>
                </UniformGrid>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Filtrare" Grid.Row="1" Margin="0,0,0,10" Foreground="#03DAC6">
            <DockPanel Margin="5">
                <Button Content="Refresh" Click="btnIncarca_Click" DockPanel.Dock="Right" Width="70" Margin="5,0,0,0"/>
                <Button Content="Done" Click="btnDone_Click" DockPanel.Dock="Right" Width="70" Margin="5,0,0,0" Background="Green" Foreground="White"/>
                <TextBox x:Name="txtCautare" Height="25" Background="#2D2D2D" Foreground="White"/>
            </DockPanel>
        </GroupBox>

        <DataGrid x:Name="dgTaskuri" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" 
                  Background="#1E1E1E" RowBackground="#252525" AlternatingRowBackground="#2D2D2D" Foreground="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Titlu" Binding="{Binding Title}" Width="*"/>
                <DataGridTextColumn Header="Categorie" Binding="{Binding Category}" Width="100"/>
                <DataGridCheckBoxColumn Header="Urgent" Binding="{Binding IsUrgent}" Width="60"/>
                <DataGridTextColumn Header="Deadline" Binding="{Binding DueDate, StringFormat=\{0:dd.MM.yyyy\}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>